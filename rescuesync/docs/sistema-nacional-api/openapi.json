{
  "openapi": "3.0.3",
  "info": {
    "title": "Sistema Nacional de Gestión de Recursos y Riesgos",
    "version": "0.1.0",
    "description": "API REST del Sistema Nacional (SN) de RescueSync. Gestiona ONGs y su stock\nde recursos, valida ofertas por niveles de competencia y compromete/libera\nrecursos con locking en PostgreSQL.\n\n**Autenticación:** `POST /auth/login` devuelve un JWT (HS256, 1 h). El\nresto de los endpoints, salvo `/health` y `/docs`, exige\n`Authorization: Bearer <token>`. Usá el botón **Authorize** con el token.\n\n**Errores:** siempre `{ \"message\": \"...\" }` con el código HTTP correcto\n(400, 401, 403, 404, 409).\n\nContrato completo: `docs/api-contracts-sistema-nacional.md`.\n",
    "license": {
      "name": "Uso académico — TP integrador DSSD 2026"
    },
    "contact": {
      "name": "Grupo RescueSync"
    }
  },
  "servers": [
    {
      "url": "https://tp-integrador-dssd-rescuesync-sistema.onrender.com",
      "description": "Producción (Render)"
    },
    {
      "url": "http://localhost:5000",
      "description": "Local (docker compose)"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Login y emisión del JWT."
    },
    {
      "name": "Sistema",
      "description": "Estado del servicio."
    },
    {
      "name": "ONGs",
      "description": "Onboarding y consulta de ONGs habilitadas."
    },
    {
      "name": "Recursos",
      "description": "Stock por ONG y disponibilidad global."
    },
    {
      "name": "Validación y compromiso",
      "description": "Validación por niveles de competencia y compromiso transaccional con locking."
    },
    {
      "name": "Cierre",
      "description": "Finalización por ONG, cierre del proyecto y liberación de recursos."
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string",
            "example": "Token ausente o inválido."
          },
          "detalle": {
            "type": "object",
            "description": "Opcional. Datos para resolver el error (ej. qué recurso no alcanza).",
            "additionalProperties": true
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "example": "rescuesync-integracion"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "tokenType": {
            "type": "string",
            "example": "Bearer"
          },
          "expiresIn": {
            "type": "integer",
            "description": "Segundos de validez",
            "example": 3600
          }
        }
      },
      "RecursoCodigo": {
        "type": "string",
        "description": "Id del catálogo (`recursos_catalogo.codigo`), igual al del cliente web.",
        "example": "paramedicos"
      },
      "StockItem": {
        "type": "object",
        "required": [
          "recursoCodigo",
          "cantidadTotal"
        ],
        "properties": {
          "recursoCodigo": {
            "$ref": "#/components/schemas/RecursoCodigo"
          },
          "cantidadTotal": {
            "type": "integer",
            "minimum": 0,
            "example": 10
          }
        }
      },
      "OngAlta": {
        "type": "object",
        "required": [
          "ref",
          "nombre",
          "nivelOperativo",
          "username",
          "password"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "example": "rescatistas-unidos"
          },
          "nombre": {
            "type": "string",
            "example": "Rescatistas Unidos"
          },
          "nivelOperativo": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4,
            "example": 3
          },
          "username": {
            "type": "string",
            "example": "rescatistas-unidos"
          },
          "password": {
            "type": "string",
            "format": "password"
          },
          "recursos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StockItem"
            }
          }
        }
      },
      "Ong": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "nivelOperativo": {
            "type": "integer"
          },
          "habilitada": {
            "type": "boolean"
          }
        }
      },
      "OngCreada": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Ong"
          },
          {
            "type": "object",
            "properties": {
              "username": {
                "type": "string",
                "example": "rescatistas-unidos"
              },
              "recursos": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/RecursoOng"
                }
              }
            }
          }
        ]
      },
      "RecursoOng": {
        "type": "object",
        "properties": {
          "recursoCodigo": {
            "$ref": "#/components/schemas/RecursoCodigo"
          },
          "nombre": {
            "type": "string",
            "example": "Paramédicos"
          },
          "unidad": {
            "type": "string",
            "example": "personas"
          },
          "cantidadTotal": {
            "type": "integer"
          },
          "cantidadComprometida": {
            "type": "integer"
          },
          "cantidadDisponible": {
            "type": "integer"
          }
        }
      },
      "Disponibilidad": {
        "allOf": [
          {
            "$ref": "#/components/schemas/RecursoOng"
          },
          {
            "type": "object",
            "properties": {
              "categoria": {
                "type": "string",
                "example": "salud"
              },
              "ongsConDisponible": {
                "type": "integer",
                "description": "ONGs habilitadas con algo disponible de este recurso"
              }
            }
          }
        ]
      },
      "OngEnOferta": {
        "type": "object",
        "required": [
          "ref",
          "rol"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "example": "rescatistas-unidos"
          },
          "rol": {
            "type": "string",
            "enum": [
              "principal",
              "apoyo"
            ]
          }
        }
      },
      "ValidacionRequest": {
        "type": "object",
        "required": [
          "emergenciaId",
          "severidad",
          "lotes",
          "ofertas"
        ],
        "properties": {
          "emergenciaId": {
            "type": "string",
            "format": "uuid"
          },
          "severidad": {
            "type": "string",
            "enum": [
              "baja",
              "media",
              "alta",
              "critica"
            ]
          },
          "lotes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "recursoCodigo": {
                  "$ref": "#/components/schemas/RecursoCodigo"
                },
                "cantidadSolicitada": {
                  "type": "integer",
                  "example": 5
                }
              }
            }
          },
          "ofertas": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ofertaId": {
                  "type": "string",
                  "format": "uuid"
                },
                "ongs": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OngEnOferta"
                  }
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "loteId": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "recursoCodigo": {
                        "$ref": "#/components/schemas/RecursoCodigo"
                      },
                      "cantidadOfrecida": {
                        "type": "integer",
                        "example": 3
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "ValidacionResponse": {
        "type": "object",
        "properties": {
          "emergenciaId": {
            "type": "string",
            "format": "uuid"
          },
          "resultados": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ofertaId": {
                  "type": "string",
                  "format": "uuid"
                },
                "nivelHabilitacion": {
                  "type": "string",
                  "enum": [
                    "PLENO",
                    "PARCIAL",
                    "APOYO",
                    "SIN_CAPACIDAD"
                  ]
                },
                "rolSugerido": {
                  "type": "string",
                  "enum": [
                    "principal",
                    "apoyo"
                  ]
                },
                "nivelRiesgoPermitido": {
                  "type": "string",
                  "enum": [
                    "baja",
                    "media",
                    "alta",
                    "critica"
                  ]
                },
                "capacidadesHabilitadas": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "loteId": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "recursoCodigo": {
                        "$ref": "#/components/schemas/RecursoCodigo"
                      },
                      "cantidadHabilitada": {
                        "type": "integer"
                      },
                      "cantidadOfrecida": {
                        "type": "integer"
                      }
                    }
                  }
                },
                "observaciones": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "resumen": {
            "type": "object",
            "properties": {
              "todosLosLotesCubiertos": {
                "type": "boolean"
              },
              "cobertura": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "loteId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "solicitada": {
                      "type": "integer"
                    },
                    "cubierta": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "CompromisoRequest": {
        "type": "object",
        "required": [
          "emergenciaId",
          "ofertas"
        ],
        "properties": {
          "emergenciaId": {
            "type": "string",
            "format": "uuid"
          },
          "ofertas": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ofertaId": {
                  "type": "string",
                  "format": "uuid"
                },
                "ongs": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OngEnOferta"
                  }
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "recursoCodigo": {
                        "$ref": "#/components/schemas/RecursoCodigo"
                      },
                      "cantidad": {
                        "type": "integer",
                        "example": 3
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "CompromisoResponse": {
        "type": "object",
        "properties": {
          "emergenciaId": {
            "type": "string",
            "format": "uuid"
          },
          "compromisos": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "compromisoId": {
                  "type": "string",
                  "format": "uuid"
                },
                "ofertaId": {
                  "type": "string",
                  "format": "uuid"
                },
                "estado": {
                  "type": "string",
                  "enum": [
                    "activo",
                    "liberado"
                  ],
                  "description": "`liberado` si el proyecto ya se cerró (el stock volvió a las ONGs)."
                },
                "yaExistia": {
                  "type": "boolean",
                  "description": "`true` si la oferta ya estaba comprometida (reintento): no se reservó de nuevo."
                },
                "reparto": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "ongRef": {
                        "type": "string"
                      },
                      "recursoCodigo": {
                        "$ref": "#/components/schemas/RecursoCodigo"
                      },
                      "cantidad": {
                        "type": "integer"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "FinalizacionResponse": {
        "type": "object",
        "properties": {
          "emergenciaId": {
            "type": "string",
            "format": "uuid"
          },
          "finalizadas": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ongRef": {
                  "type": "string",
                  "example": "rescatistas-unidos"
                },
                "finalizadaAt": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          },
          "ongsSinFinalizar": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "manos-solidarias"
            ]
          }
        }
      },
      "CierreResponse": {
        "type": "object",
        "properties": {
          "emergenciaId": {
            "type": "string",
            "format": "uuid"
          },
          "compromisosLiberados": {
            "type": "integer",
            "example": 2
          },
          "recursosLiberados": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ongRef": {
                  "type": "string",
                  "example": "rescatistas-unidos"
                },
                "recursoCodigo": {
                  "$ref": "#/components/schemas/RecursoCodigo"
                },
                "cantidad": {
                  "type": "integer",
                  "example": 4
                }
              }
            }
          },
          "ongsSinFinalizar": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Datos inválidos",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Falta el token o es inválido / está vencido",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Forbidden": {
        "description": "El rol del token no puede usar este endpoint",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "No existe",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Conflict": {
        "description": "Conflicto (ej. stock insuficiente o ref duplicado)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Login y emisión del JWT",
        "description": "Público. Límite de 10 intentos cada 15 minutos por IP.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              },
              "example": {
                "username": "rescuesync-integracion",
                "password": "********"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token emitido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                },
                "example": {
                  "accessToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiaW50ZWdyYWNpb24i…",
                  "tokenType": "Bearer",
                  "expiresIn": 3600
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "description": "Falta el token o es inválido / está vencido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "message": "Usuario o contraseña incorrectos."
                }
              }
            }
          },
          "429": {
            "description": "Demasiados intentos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "operationId": "login"
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Sistema"
        ],
        "summary": "Healthcheck (API y base)",
        "security": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "db": {
                      "type": "string",
                      "example": "ok"
                    }
                  }
                },
                "example": {
                  "status": "ok",
                  "db": "ok"
                }
              }
            }
          },
          "503": {
            "description": "La base no responde",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "operationId": "healthcheck"
      }
    },
    "/ongs": {
      "post": {
        "tags": [
          "ONGs"
        ],
        "summary": "Onboarding de ONG (crea la ONG habilitada y su usuario)",
        "description": "Rol: integracion. Crea la ONG habilitada, su cuenta (rol `ong`) y el\nstock inicial en una sola transacción (todo o nada). 400 si algún\n`recursoCodigo` no existe en el catálogo (`detalle.recursosDesconocidos`);\n409 si el `ref` o el `username` ya existen (`detalle.campo`).\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OngAlta"
              },
              "example": {
                "ref": "rescatistas-unidos",
                "nombre": "Rescatistas Unidos",
                "nivelOperativo": 3,
                "username": "rescatistas-unidos",
                "password": "********",
                "recursos": [
                  {
                    "recursoCodigo": "paramedicos",
                    "cantidadTotal": 4
                  },
                  {
                    "recursoCodigo": "botes",
                    "cantidadTotal": 2
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "ONG creada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OngCreada"
                },
                "example": {
                  "ref": "rescatistas-unidos",
                  "nombre": "Rescatistas Unidos",
                  "nivelOperativo": 3,
                  "habilitada": true,
                  "username": "rescatistas-unidos",
                  "recursos": [
                    {
                      "recursoCodigo": "botes",
                      "nombre": "Botes de rescate",
                      "unidad": "unidades",
                      "cantidadTotal": 2,
                      "cantidadComprometida": 0,
                      "cantidadDisponible": 2
                    },
                    {
                      "recursoCodigo": "paramedicos",
                      "nombre": "Paramédicos",
                      "unidad": "personas",
                      "cantidadTotal": 4,
                      "cantidadComprometida": 0,
                      "cantidadDisponible": 4
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "description": "Conflicto (ej. stock insuficiente o ref duplicado)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "message": "Ya existe una ONG con ese ref.",
                  "detalle": {
                    "campo": "ref"
                  }
                }
              }
            }
          }
        },
        "operationId": "crearOng"
      },
      "get": {
        "tags": [
          "ONGs"
        ],
        "summary": "ONGs habilitadas",
        "description": "Rol: cualquier usuario autenticado.",
        "responses": {
          "200": {
            "description": "Lista de ONGs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Ong"
                  }
                },
                "example": [
                  {
                    "ref": "manos-solidarias",
                    "nombre": "Manos Solidarias",
                    "nivelOperativo": 2,
                    "habilitada": true
                  },
                  {
                    "ref": "rescatistas-unidos",
                    "nombre": "Rescatistas Unidos",
                    "nivelOperativo": 3,
                    "habilitada": true
                  }
                ]
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        },
        "operationId": "listarOngs"
      }
    },
    "/ongs/{ref}/recursos": {
      "parameters": [
        {
          "name": "ref",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          },
          "example": "rescatistas-unidos"
        }
      ],
      "put": {
        "tags": [
          "Recursos"
        ],
        "summary": "Alta/actualización del stock de una ONG",
        "description": "Rol: integracion. Crea o actualiza `cantidadTotal` de los recursos\nenviados; los no enviados quedan como estaban. Devuelve el stock\ncompleto de la ONG. 409 si un total quedaría por debajo de lo ya\ncomprometido (`detalle.insuficientes`); en ese caso no cambia nada.\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/StockItem"
                }
              },
              "example": [
                {
                  "recursoCodigo": "paramedicos",
                  "cantidadTotal": 6
                },
                {
                  "recursoCodigo": "raciones",
                  "cantidadTotal": 500
                }
              ]
            }
          }
        },
        "responses": {
          "200": {
