# Server
PORT=4000
NODE_ENV=development
# Firma la cookie de sesión de la app (connect.sid). Cualquier texto largo.
SESSION_SECRET=clave-session-secret

# Postgres — deben coincidir con las credenciales del contenedor en
# ../docker-compose.yml (ver nota en README.md sobre dónde se leen).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rescuesync
DB_USER=rescuesync
DB_PASSWORD=changeme
DATABASE_URL=postgresql://rescuesync:changeme@localhost:5432/rescuesync

# Sistema Nacional (API externa, JWT) — pendiente de implementar (Entrega 3)
SISTEMA_NACIONAL_API_URL=http://localhost:5000
SISTEMA_NACIONAL_JWT_SECRET=changeme

# Bonita (BPM). Dentro de Docker, docker-compose.yml la pisa con
# host.docker.internal (ver README.md, "Login con Bonita").
BONITA_API_URL=http://localhost:8080/bonita
# Nombre del proceso a iniciar; el server busca solo su id entre los desplegados y activos.
BONITA_PROCESS_NAME=GestionarEmergencia
# Hoy NO se usan: cada persona se loguea con su propio usuario de Bonita.
# Reservadas por si más adelante hace falta un usuario técnico.
BONITA_USERNAME=OperadorM
BONITA_PASSWORD=changeme

# Shared with the Bonita runtime; generate a long random value locally.
BONITA_NOTIFICATION_TOKEN=
