# Server
PORT=4000
NODE_ENV=development
SESSION_SECRET=clave-session-secret

# Postgres — deben coincidir con las credenciales del contenedor en
# ../docker-compose.yml (ver nota en README.md sobre dónde se leen).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rescuesync
DB_USER=rescuesync
DB_PASSWORD=changeme
DATABASE_URL=postgresql://rescuesync:changeme@localhost:5432/rescuesync

# Sistema Nacional (API externa, JWT) — pendiente de implementar (Entrega 3)
SISTEMA_NACIONAL_API_URL=http://localhost:5000
SISTEMA_NACIONAL_JWT_SECRET=changeme

# Bonita (BPM) — credenciales del usuario técnico usado por el server para
# autenticarse contra el login service de Bonita
BONITA_API_URL=http://localhost:8080/bonita
BONITA_USER=install
BONITA_PASSWORD=changeme
