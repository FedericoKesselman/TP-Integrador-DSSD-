# Server
PORT=4000
NODE_ENV=development
# Firma la cookie de sesión de la app (connect.sid). Cualquier texto largo.
SESSION_SECRET=clave-session-secret

# Postgres — deben coincidir con las credenciales del contenedor en
# ../docker-compose.yml (ver nota en README.md sobre dónde se leen).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rescuesync
DB_USER=rescuesync
DB_PASSWORD=changeme
DATABASE_URL=postgresql://rescuesync:changeme@localhost:5432/rescuesync

# Sistema Nacional (API externa, JWT). Solo "Mi inventario" le habla desde acá
# (cuenta de integración); el resto del ciclo lo hace Bonita.
# URL por defecto en el código: la de Render. Descomentar para usar el SN local.
# SISTEMA_NACIONAL_API_URL=http://localhost:5000
SN_INTEGRATION_USERNAME=rescuesync-integracion
SN_INTEGRATION_PASSWORD=changeme

# Bonita (BPM). Dentro de Docker, docker-compose.yml la pisa con
# host.docker.internal (ver README.md, "Login con Bonita").
BONITA_API_URL=http://localhost:8080/bonita
# Nombre del proceso a iniciar; el server busca solo su id entre los desplegados y activos.
BONITA_PROCESS_NAME=Gestionar Emergencia
# Usuario técnico de Bonita: lo usa el backend del dashboard (solo GET a bpm/archivedTask y
# archivedCase). SOLUCIÓN TEMPORAL, solo desarrollo local; ver E5-60 y E5-95 del roadmap de la
# Entrega 5. El resto de las personas se loguea con su propio usuario de Bonita.
BONITA_USERNAME=
BONITA_PASSWORD=

# Clave única de integración: Bonita la manda en el header X-Integration-Key a
# /api/internal/*. En Bonita es un parámetro del proceso (claveIntegracion).
# Generar un valor largo y aleatorio.
BONITA_INTEGRATION_KEY=
