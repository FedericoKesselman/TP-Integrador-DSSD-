# true: el cliente guarda las emergencias en localStorage (no requiere backend)
# false: el cliente llama a la API real (/api, con proxy a http://localhost:4000)
VITE_USE_MOCK_API=false

# Motor de cálculo dinámico humanitario (Normas Esfera / Cascos Blancos per cápita)
# true: calcula automáticamente según damnificados y gravedad (con botón mágico y presets adaptativos)
# false: usa el desglose clásico con cantidades fijas predeterminadas (defaultQty)
VITE_ENABLE_HUMANITARIAN_CALC=false
VITE_ENABLE_CALCULO_HUMANITARIO=false
