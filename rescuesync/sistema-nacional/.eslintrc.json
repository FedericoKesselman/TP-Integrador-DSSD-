{
  "root": true,
  "env": {
    "node": true,
    "es2022": true
  },
  "extends": ["airbnb-base", "prettier"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "import/prefer-default-export": "off",
    "import/extensions": ["error", "ignorePackages"]
  }
}
