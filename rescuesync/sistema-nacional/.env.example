# Copiar a .env y completar. Nunca commitear el .env real.

# Server
PORT=5000
NODE_ENV=development

# Postgres propio del Sistema Nacional (no es la base de la web-app).
# Local: el contenedor de docker-compose.yml de esta carpeta (puerto 5433,
# para no chocar con el Postgres de web-app en el 5432).
# Neon (producción): usar la connection string DIRECTA (sin "-pooler" en el
# host) y con ?sslmode=require al final, ej.:
# postgresql://usuario:clave@ep-xxxx.us-east-2.aws.neon.tech/sn?sslmode=require
DATABASE_URL=postgresql://sn:changeme@localhost:5433/sistema_nacional

# JWT (HS256). JWT_SECRET: texto aleatorio de 32+ caracteres; en producción
# solo como variable de entorno de Render. Generar uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio-de-32-caracteres-o-mas
JWT_EXPIRES_IN=3600
JWT_ISSUER=rescuesync-sistema-nacional
JWT_AUDIENCE=rescuesync

# Cuenta de integración (la usa Bonita). `npm run seed` la crea o le
# actualiza la clave; sin SN_INTEGRATION_PASSWORD no se crea nada.
SN_INTEGRATION_USERNAME=rescuesync-integracion
SN_INTEGRATION_PASSWORD=cambiar-esta-clave

# Orígenes permitidos para CORS, separados por coma ("*" = todos). Bonita
# llama servidor a servidor, así que CORS solo importa para Swagger UI y
# pruebas desde el navegador.
CORS_ORIGINS=*
